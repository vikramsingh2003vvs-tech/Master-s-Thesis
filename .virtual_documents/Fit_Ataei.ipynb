# --- Fit globale gradino via cl.build_global_residual ---

# ===============================================================
# IMPOSTAZIONE BOUNDS SCELTI DALL'UTENTE
# ===============================================================
MIN_GAMMA_MEV = 1
MAX_GAMMA_MEV = 200.0

MIN_PHI = 0.1
MAX_PHI = np.pi/4
beh_phi = 'dec' #behaviour of phi, inc or dec_(reases)

MIN_MSTAR = 1
MAX_MSTAR = 5.0

MIN_TPHI = 150.0
MAX_TPHI = 500.0

# ===============================================================

# parametri: [a1, c1, a2, c2, phi0, dphi, T_phi, m_star]
print("Esecuzione del Fit Globale Simultaneo (gradino)...")

def _unpack_step(p, T):
    a1, c1, a2, c2, phi0, dphi, T_phi, m_star = p
    G1 = eval_T_dep(T, a1, c1, T_DEP["G1"])
    G2 = eval_T_dep(T, a2, c2, T_DEP["G2"])
    ph = phi_tanh(T, phi0, dphi, T_phi)
    return G1, G2, ph, m_star

_model_step = lambda B, G1, G2, ph, ms: 1.0 + cl.mr_step(B, G1, G2, ph, ms)

# n_bins=60 bilancia i pesi tra bassi e alti B (log-binning), sostituisce [::10]
residual_step = build_global_residual(_model_step, DATA, B_MIN, _unpack_step, n_bins=60)
print(f"  punti totali dopo log-bin: {residual_step.total_pts}")


T_MAX = max(T_LIST)  # 100 K qui
C_MAX = MAX_GAMMA_MEV  # intercept max equivale al massimo possibile di Gamma

# p0 guidato dai fit indipendenti: Gamma_i(T=80K) ~ 25-30 meV, offset ~5-10 meV
p0_glob = [
    _p0_a(T_DEP["G1"], 50.0, 10.0, T_MAX),
    10.0,
    _p0_a(T_DEP["G2"], 50.0, 10.0, T_MAX),
    5.0,
    0.7,
    0.1,
    30.0,
    3.0,
]

# Formattazione dinamica di lb e ub in base alle scelte utente
# [a1, c1, a2, c2, phi0, dphi, T_phi, m_star]
lb = [
    0.0, MIN_GAMMA_MEV, 
    0.0, MIN_GAMMA_MEV, 
    MIN_PHI, -(MAX_PHI - MIN_PHI), 
    MIN_TPHI, MIN_MSTAR
]

ub = [
    _a_cap(T_DEP["G1"], MAX_GAMMA_MEV, MIN_GAMMA_MEV, T_MAX), MAX_GAMMA_MEV,
    _a_cap(T_DEP["G2"], MAX_GAMMA_MEV, MIN_GAMMA_MEV, T_MAX), MAX_GAMMA_MEV,
    MAX_PHI, (MAX_PHI - MIN_PHI),
    MAX_TPHI, MAX_MSTAR
]

if beh_phi == 'inc':
    ub[5] = 0
else:
    ub[5] = 0.17
    ub[4] = 0.61

# Calcolo scale e diff_step dinamico
lb_arr = np.array(lb)
ub_arr = np.array(ub)
x_scale_dyn = ub_arr - lb_arr
x_scale_dyn = np.where(x_scale_dyn == 0, 1.0, x_scale_dyn)
diff_step_dyn = 1e-5 * np.ones_like(lb_arr)

# Sicurezza per evitare conflitti con initial guess fuori dai nuovi bounds
p0_glob = np.clip(p0_glob, lb_arr + 1e-8, ub_arr - 1e-8)

print(f"  Range fisico impostato: Gamma in [{MIN_GAMMA_MEV}, {MAX_GAMMA_MEV}], m_star in [{MIN_MSTAR}, {MAX_MSTAR}]")

MAX_NFEV = 3000
pbar = tqdm(total=MAX_NFEV, desc="Fit gradino globale")

def _r(x):
    pbar.update(1)
    return residual_step(x)

with warnings.catch_warnings():
    warnings.simplefilter("ignore")
    res_glob = least_squares(
        _r,
        x0=p0_glob,
        bounds=(lb, ub),
        max_nfev=MAX_NFEV,
        loss="huber",
        ftol=1e-10,
        xtol=1e-10,
        gtol=1e-8,
        x_scale=x_scale_dyn,      # <- Applica la scala calcolata
        diff_step=diff_step_dyn,  # <- Applica il passo di differenziazione ottimale
    )
pbar.close()

opt_params = res_glob.x
a1_opt, c1_opt, a2_opt, c2_opt, phi0_opt, dphi_opt, T_phi_opt, m_star_opt = opt_params
rms_step = float(np.sqrt(np.mean(res_glob.fun**2)))

_t_g1 = {"linear": "T", "quadratic": "T^2"}[T_DEP["G1"]]
_t_g2 = {"linear": "T", "quadratic": "T^2"}[T_DEP["G2"]]

# sanity: stampa Gamma_i(T) a T_LIST
print("\nGamma_i(T) dal fit globale:")
for T in T_LIST:
    g1 = eval_T_dep(T, a1_opt, c1_opt, T_DEP["G1"])
    g2 = eval_T_dep(T, a2_opt, c2_opt, T_DEP["G2"])
    print(f"  T={T:4.0f} K  Gamma_1={g1:7.3f} meV  Gamma_2={g2:7.3f} meV")

display(Markdown(f"""
**Risultati Fit Globale - modello gradino** _({res_glob.nfev} eval, status {res_glob.status})_

- $m^{{\\ast}}/m_e = \\mathbf{{{m_star_opt:.4f}}}$
- $\\Gamma_1(T) = {a1_opt:.5f}\\,{_t_g1} + {c1_opt:.3f}$ meV
