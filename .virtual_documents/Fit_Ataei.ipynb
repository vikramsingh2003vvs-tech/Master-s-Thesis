    "c_eff": c_eff_Nd,  # rho_scale_true * c_true (degenere)
    "c_eff_err": dc_eff_Nd,
    "slope_exp_uOhmcm_K": slope_exp_Nd,
    "rho0_exp_uOhmcm": rho0_exp_Nd,
    "T_range_K": (float(T_fit.min()), float(T_fit.max())),
    "note": (
