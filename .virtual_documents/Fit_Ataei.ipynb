# Tuttavia, per semplicità, mappiamole manualmente:
T_MAPPING = {
    4.0: (0, 1),
    30.0: (10, 11), # Le ultime due colonne di MOESM6 (che era il secondo file caricato)
    40.0: (2, 3),
